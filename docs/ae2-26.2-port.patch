# Applied Energistics 2 -- port from Minecraft 26.1.2 to 26.2
#
# Baseline: upstream AppliedEnergistics/Applied-Energistics-2 tag v26.1.11-beta
#   git clone https://github.com/AppliedEnergistics/Applied-Energistics-2.git
#   cd Applied-Energistics-2 && git checkout v26.1.11-beta
#   patch -p1 < ae2-26.2-port.patch
#
# Requires GuideME to be ported first and published to mavenLocal as 26.2.0-ae2port:
# see the sibling guideme-26.2-port.patch.
#
# Target: minecraft 26.2 / neoforge 26.2.0.81 (requires JDK 25)
# State:  ./gradlew build -x test -> BUILD SUCCESSFUL
#         ./gradlew test          -> 489 tests, 0 failures (boots the modded environment)
#         Dev runtime item-list and tooltip mods are set to "none": no 26.2 build of
#         jei/emi/rei/jade/wthit exists yet.
#         Fabric: not started
#
diff -ruN '--exclude=build' '--exclude=.git' '--exclude=.gradle' '--exclude=run' '--exclude=.idea' '--exclude=logs' ae2-upstream/gradle.properties ae2-262-snapshot/gradle.properties
diff -ruN '--exclude=build' '--exclude=.git' '--exclude=.gradle' '--exclude=run' '--exclude=.idea' '--exclude=logs' ae2-upstream/gradle.properties ae2-262-snapshot/gradle.properties
--- ae2-upstream/gradle.properties	2026-09-17 05:04:28.475642866 -0700
+++ ae2-262-snapshot/gradle.properties	2026-09-17 05:36:41.100807046 -0700
@@ -7,15 +7,16 @@
 #########################################################
 # Minecraft Versions                                    #
 #########################################################
-minecraft_version=26.1.2
+minecraft_version=26.2
 # https://projects.neoforged.net/neoforged/neoforge
-neoforge_version=26.1.2.21-beta
-neoforge_version_range=[26.1.2.21-beta,)
+neoforge_version=26.2.0.81
+neoforge_version_range=[26.2.0.0,)
 
 #########################################################
 # Provided APIs                                         #
 #########################################################
-guideme_version=26.1.10-alpha
+# Ported to 26.2 alongside AE2 and published to mavenLocal; see guideme-26.2-port.patch
+guideme_version=26.2.0-ae2port
 jei_version=29.5.0.26
 jei_minecraft_version=26.1.2
 emi_version=1.1.19+1.21.1
@@ -33,11 +34,14 @@
 
 # Pick which item list mod gets picked at runtime in dev
 # Available options: emi, rei, jei, none
-runtime_itemlist_mod=jei
+# 26.2: jei 29.5.0.26 targets minecraft [26.1,26.1.2] and emi/rei are older still, so none of the three
+# can load. Switch back once one of them ships a 26.2 build.
+runtime_itemlist_mod=none
 
 # Set to wthit, jade or none to pick which tooltip mod gets picked at runtime
 # for the dev environment.
-runtime_tooltip_mod=jade
+# 26.2: the pinned jade and wthit builds are 26.1-only.
+runtime_tooltip_mod=none
 
 # Set to true to use Curio at runtime
 runtime_curio=false
